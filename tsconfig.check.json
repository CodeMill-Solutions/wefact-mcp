{
  // Type-checking-only config. The build config (tsconfig.json) is scoped to
  // `src` with `rootDir: "./src"`, which means `scripts/` and `test/` are never
  // checked by `npm run build` — and `scripts/` has never been checked at all.
  //
  // Tests deliberately live outside `src`: anything under `src` is emitted to
  // `dist`, and package.json ships `files: ["dist"]`, so a test file there
  // would be published to npm.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": "."
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*", "vitest.config.ts"]
}
