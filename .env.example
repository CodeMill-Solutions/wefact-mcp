# WeFact API key — create one under "Instellingen → API" in your WeFact
# administration. One key belongs to exactly one administration.
#
# IMPORTANT: WeFact also requires you to whitelist the public IP address of the
# machine running this server, on that same settings page. Without it every call
# fails with "IP <address> has no access to API". Run `npm run whoami` to print
# the IP that needs whitelisting.
WEFACT_API_KEY=

# Optional label for the administration this key belongs to (free choice, used
# as the `administration` selector in tools, e.g. "demo" or the company name).
# When omitted, the key is registered under the label "default".
WEFACT_ADMINISTRATION=

# Optional explicit path to the multi-administration credentials JSON file.
# Default precedence: WEFACT_CREDENTIALS_FILE → ~/.wefact/credentials.json → ./credentials.json
WEFACT_CREDENTIALS_FILE=

# When set to "true", allows API calls that create, update or delete data.
# Every write tool additionally stays in dry-run mode until called with
# `confirm: true`.
WEFACT_ALLOW_WRITES=

# Second gate, required *in addition to* WEFACT_ALLOW_WRITES, for the tools that
# send real email to your customers: send_invoice_by_email,
# send_invoice_reminder, send_price_quote_by_email, schedule_document_send, and
# transaction matching with Reversal.NotifyClient.
WEFACT_ALLOW_SEND=

# Request encoding: "json" (default, verified) or "form" (application/x-www-form-urlencoded).
# Escape hatch only — leave unset unless an endpoint rejects a JSON body.
WEFACT_TRANSPORT=

# Rows fetched per page by the auto-paginating list tools. WeFact allows up to
# 1000; this server defaults to 500 to keep tool results within an agent's context.
WEFACT_PAGE_SIZE=

# Stop issuing requests when fewer than this many calls remain in the current
# minute, and wait for the window to reset instead. WeFact bans the IP when the
# limit is breached, so the reserve is deliberately conservative. Default: 5.
WEFACT_RATE_LIMIT_RESERVE=

# Retries for transient failures (HTTP 429/5xx, dropped connections). Default: 2.
# Rate-limit bans and authentication failures are never retried automatically.
WEFACT_MAX_RETRIES=
